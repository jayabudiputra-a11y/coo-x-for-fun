{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/rss", "destination": "/rss/index.xml" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}